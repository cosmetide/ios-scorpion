+/* Print directly through the early PE console without the kprintf/IOLog locks. */
+static void
+sweet_smp_console_hex(const char *label, uint64_t value)
+{
+	if (PE_kputc == NULL) {
+		return;
+	}
+	while (*label != '\0') {
+		PE_kputc(*label++);
+	}
+	static const char digits[] = "0123456789abcdef";
+	for (int shift = 60; shift >= 0; shift -= 4) {
+		PE_kputc(digits[(value >> shift) & 0xf]);
+	}
+	PE_kputc('\n');
+}
 

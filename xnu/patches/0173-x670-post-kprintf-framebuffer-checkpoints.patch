@@ -595,8 +596,10 @@
 #endif
 
 	cpu_machine_idle_init(TRUE);
+	sweet_early_mark(21, "cpu idle init complete");
 
 	PE_init_platform(TRUE, &BootCpuData);
+	sweet_early_mark(21, "PE_init_platform returned");
 
 #if __arm64__
 	extern bool cpu_config_correct;
@@ -613,6 +616,7 @@
 #endif
 
 	cpu_timebase_init(TRUE);

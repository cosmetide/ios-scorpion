 static int
+sd_write_sector(uint64_t lba, const uint8_t *in)
+{
+	uint32_t arg, status, sent = 0;
+	if (!sd.high_capacity && lba > (UINT32_MAX / SD_SECTOR)) return EINVAL;
+	arg = sd.high_capacity ? (uint32_t)lba : (uint32_t)(lba * SD_SECTOR);
+	if ((uint64_t)arg != (sd.high_capacity ? lba : lba * SD_SECTOR)) return EINVAL;
+	sd.stage = "CMD24 write sector";
+	sd.last_op = 24;
+	sd.last_arg = arg;
+	sd.last_lba = lba;
+	sd.last_status = 0;
+	sd.last_got = 0;
+	sd_wr(R_INT, sd_rd(R_INT));
+	sd_wr(R_FIFOCS, 1u << 31);
+	sd_wr(R_BLK_NUM, 1);
+	sd_wr(R_SDC_ARG, arg);
+	sd_wr(R_SDC_CMD, SD_CMD(24, 1, SD_SECTOR, 1) | SDC_CMD_WR);
+	if (sd_wait_int(INT_CMDRDY | INT_CMDTMO | INT_RSPCRCERR, &status, 1000000)) {
+		sd.last_status = sd_rd(R_INT);
+		return ETIMEDOUT;
+	}
+	sd.last_status = status;
+	if (status & (INT_CMDTMO | INT_RSPCRCERR)) return EIO;
+
+	for (uint32_t loops = 0; loops < 1000000; loops++) {
+		uint32_t intr = sd_rd(R_INT);
+		if (intr & (INT_DATTMO | INT_DATCRCERR)) {
+			sd.last_status = intr;
+			sd.last_got = sent;
+			sd_wr(R_INT, intr);
+			return (intr & INT_DATTMO) ? ETIMEDOUT : EIO;
+		}
+		uint32_t queued = (sd_rd(R_FIFOCS) & FIFO_TXCNT) >> 16;
+		uint32_t room = queued < FIFO_SIZE ? FIFO_SIZE - queued : 0;
+		while (sent < SD_SECTOR && room >= 4) {
+			uint32_t word = (uint32_t)in[sent] | ((uint32_t)in[sent + 1] << 8) |
+			    ((uint32_t)in[sent + 2] << 16) | ((uint32_t)in[sent + 3] << 24);
+			sd_wr(R_TXDATA, word);
+			sent += 4;
+			room -= 4;
+		}
+		if (intr & INT_XFER_COMPL) {
+			sd.last_status = intr;
+			sd.last_got = sent;
+			sd_wr(R_INT, intr);
+			if (sent != SD_SECTOR) return EIO;
+			break;
+		}
+		if (intr) sd_wr(R_INT, intr);
+		delay(1);
+		if (loops == 999999) {
+			sd.last_status = sd_rd(R_INT);
+			sd.last_got = sent;
+			return ETIMEDOUT;
+		}
+	}
+	/* A completed data phase is followed by the card's internal program busy. */
+	for (unsigned i = 0; i < 1000000; i++) {
+		if (sd_rd(R_PS) & PS_DAT0) break;
+		delay(1);
+		if (i == 999999) return ETIMEDOUT;
+	}
+	/* Confirm the card returned to TRAN and is ready before completing the bio. */
+	for (unsigned i = 0; i < 1000; i++) {
+		uint32_t r1 = 0;
+		if (!sd_command(13, sd.rca, 1, &r1) && (r1 & (1u << 8)) && (((r1 >> 9) & 0xf) == 4))
+			return 0;
+		delay(1000);
+	}
+	return EIO;
+}

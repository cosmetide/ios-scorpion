@@ -515,10 +515,10 @@ LEXT(start_first_cpu)
 
 #if defined(SWEET)
 	/* Stage 0: white 64x32 band, no stack or page tables needed. */
-	MOV64	x0, (0x9c000000 + 2368 * 4320)
+	MOV64	x0, (0x76c10000 + 2368 * 4352)	/* X670 LK framebuffer, pitch 1088 px */
 	mov		w1, #-1
 	mov		x2, #32
-	mov		x4, #4320
+	mov		x4, #4352
 Lsweet_mark_row:
 	mov		x3, #64
 	mov		x5, x0
@@ -680,14 +680,14 @@ Lkernelcache_base_found:
 
 #if defined(SWEET)
 	/*
-	 * Splash framebuffer: one 32MB Normal-NC block in the EXISTING V=P
+	 * Splash framebuffer: one 32MB Device block in the EXISTING V=P
 	 * L2 table. Both framebuffer and RAM use L1 index 0; another call to
 	 * create_bootstrap_mapping would replace the RAM L2 table.
 	 * SWEET uses 16K pages and all bring-up RAM is below 4GB, so the first
 	 * V=P L2 page is bootstrap_pagetables + 2*PGBYTES.
 	 */
-	MOV64	x10, 0x9c000000
-	MOV64	x11, (ARM_TTE_TYPE_BLOCK | ARM_TTE_VALID | ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) | ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) | ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX)
+	MOV64	x10, 0x76000000	/* 32MB block holding the X670 framebuffer */
+	MOV64	x11, (ARM_TTE_TYPE_BLOCK | ARM_TTE_VALID | ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) | ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_DISABLE) | ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX)
 	orr		x11, x11, x10
 	and		x12, x10, #(ARM_TT_L2_INDEX_MASK)
 	lsr		x12, x12, #(ARM_TT_L2_SHIFT)
diff --git a/osfmk/arm64/sweet_early.c b/osfmk/arm64/sweet_early.c
index 6928957..fd2868b 100644
--- a/osfmk/arm64/sweet_early.c
+++ b/osfmk/arm64/sweet_early.c
@@ -1,5 +1,5 @@
 /*
- * Redmi Note 10 Pro bootstrap console. No allocation, locks, ADT parsing or
+ * Bootstrap console (Redmi Note 11 Pro 4G / viva). No allocation, locks, ADT parsing or
  * per-CPU state: panic() can reach this before a current thread exists.
  * start.s maps the splash framebuffer VA=PA as Normal Non-Cacheable memory.
  * arm_vm_init installs a reserved kernel VA alias before removing TTBR0;
@@ -11,11 +11,12 @@
 #include <stdint.h>
 #include <kern/misc_protos.h>
 
-static volatile uint32_t *early_fb = (volatile uint32_t *)(uintptr_t)0x9c000000;
+static volatile uint32_t *early_fb = (volatile uint32_t *)(uintptr_t)SWEET_EARLY_FB_PHYS;
+static volatile uint32_t *early_dsi;
 #define EARLY_FB early_fb
 #define EARLY_WIDTH 1080u
-#define EARLY_HEIGHT 2400u
-#define EARLY_STRIDE (4320u / 4)
+#define EARLY_HEIGHT SWEET_EARLY_FB_ROWS
+#define EARLY_STRIDE (SWEET_EARLY_FB_ROWBYTES / 4)
 #define EARLY_SCALE 2u
 #define EARLY_CELL_W (8u * EARLY_SCALE)
 #define EARLY_CELL_H (16u * EARLY_SCALE)
@@ -28,6 +29,21 @@ extern unsigned char iso_font[256 * 16];
 static unsigned int early_row, early_col;
 static unsigned int early_started, early_disabled, early_panicking;
 
+/* LK leaves MT6781's OVL/DSI path configured. In command mode the panel's
+ * GRAM changes only when the DSI host starts a frame transfer. */
+static void
+sweet_early_refresh(void)
+{
+	if (early_dsi == 0) {
+		return;
+	}
+	/* Trigger one frame on LK's configured DSI host; do not reconfigure clocks. */
+	__asm__ volatile("dsb sy" ::: "memory");
+	early_dsi[0] = 0;
+	early_dsi[0] = 1;
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
 static void
 sweet_early_clear_row(void)
 {
@@ -57,6 +73,7 @@ sweet_early_putc(char c)
 		early_col = 0;
 		early_row = (early_row + 1) % EARLY_ROWS;
 		sweet_early_clear_row();
+		sweet_early_refresh();
 		if (c == '\n') {
 			return;
 		}
@@ -126,10 +143,11 @@ sweet_early_panic(const char *fmt, va_list *args)
 }
 
 void
-sweet_early_relocate(uint64_t base)
+sweet_early_relocate(uint64_t base, uint64_t dsi_base)
 {
 	sweet_early_mark(8, "leaving bootstrap TTBR0");
 	early_fb = (volatile uint32_t *)(uintptr_t)base;
+	early_dsi = (volatile uint32_t *)(uintptr_t)dsi_base;
 	__asm__ volatile("dsb sy" ::: "memory");
 	sweet_early_mark(9, "kernel framebuffer VA live");
 }
diff --git a/osfmk/arm64/sweet_early.h b/osfmk/arm64/sweet_early.h
index d7a25f2..ba00b71 100644
--- a/osfmk/arm64/sweet_early.h
+++ b/osfmk/arm64/sweet_early.h
@@ -7,10 +7,22 @@
 #include <stdint.h>
 
 #if defined(SWEET)
+/*
+ * X670 (MT6781): LK's framebuffer, ARGB8888, pitch 1088 px. The framebuffer
+ * starts at 0x76c10000 in the 0x76000000 L2 block, and all 2400 rows fit
+ * before that block ends at 0x78000000. The block sits below the TEE carveout,
+ * and is mapped as Device memory for safe early writes.
+ */
+#define SWEET_EARLY_FB_PHYS     0x76c10000ULL
+#define SWEET_EARLY_FB_BLOCK    0x76000000ULL
+#define SWEET_EARLY_FB_ROWBYTES 4352u
+#define SWEET_EARLY_FB_ROWS     2400u
+#define SWEET_EARLY_DSI_PHYS    0x14013000ULL
+#define SWEET_EARLY_DSI_BLOCK   0x14000000ULL
 void sweet_early_mark(unsigned int stage, const char *label);
 void sweet_early_putc(char c);
 void sweet_early_panic(const char *fmt, va_list *args);
-void sweet_early_relocate(uint64_t base);
+void sweet_early_relocate(uint64_t fb_base, uint64_t dsi_base);
 void sweet_early_disable(void);
 #else
 static inline void sweet_early_mark(unsigned int stage, const char *label)

+#endif
 
--- a/osfmk/arm64/machine_routines.c
+++ b/osfmk/arm64/machine_routines.c
@@ -564,6 +564,15 @@
 void
 slave_machine_init(__unused void *param)
 {
+#if defined(SWEET)
+	if (cpu_number() == 1) kprintf("SMP1:G cpu-init-enter\n");
+#endif
 	cpu_machine_init();     /* Initialize the processor */
+#if defined(SWEET)
+	if (cpu_number() == 1) kprintf("SMP1:H cpu-init-return\n");
+#endif
 	clock_init();           /* Init the clock */
+#if defined(SWEET)
+	if (cpu_number() == 1) kprintf("SMP1:I clock-init-return\n");
+#endif
 }

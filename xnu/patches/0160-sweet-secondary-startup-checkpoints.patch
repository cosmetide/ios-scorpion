@@ -847,6 +847,9 @@
 		thread->continuation = processor_start_thread;
 		thread->parameter = machine_param;
 	}
 
+#if defined(SWEET)
+	if (processor->cpu_id == 1) kprintf("SMP1:D slave-main\n");

@@ -564,6 +564,15 @@
 void
 slave_machine_init(__unused void *param)
 {
+#if defined(SWEET)
+	kprintf("SWEET SMP: cpu=%u cpu_machine_init enter\n", cpu_number());
+#endif
 	cpu_machine_init();     /* Initialize the processor */

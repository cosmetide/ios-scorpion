+static int
+sd_set_clock_div(uint32_t div)
+{
+	uint32_t cfg = sd_rd(R_CFG);
+	sd_wr(R_CFG, cfg & ~CFG_CKPDN);
+	cfg = sd_rd(R_CFG) & ~(CFG_CKDIV_MASK | CFG_CKMOD_MASK);
+	cfg |= CFG_MODE | CFG_PIO | (div << 8);
+	sd_wr(R_CFG, cfg);
+	for (unsigned i = 0; i < 100000 && !(sd_rd(R_CFG) & CFG_CKSTB); i++) delay(1);
+	if (!(sd_rd(R_CFG) & CFG_CKSTB)) return ETIMEDOUT;
+	sd_wr(R_CFG, sd_rd(R_CFG) | CFG_CKPDN);
+	return 0;
 }
 

+bool
+VivaFTS::powerOn(void)
+{
+	if (fGPIO->setOutput(fVddPin, true) != kIOReturnSuccess) {
+		IOLog("X670 FTS: could not enable touch VDD GPIO%u\n", fVddPin);
+		return false;
+	}
+	IOSleep(10);
+	if (fGPIO->setOutput(fResetPin, false) != kIOReturnSuccess) {
+		IOLog("X670 FTS: could not assert reset GPIO%u\n", fResetPin);
+		return false;
+	}
+	IOSleep(20);
+	if (fGPIO->setOutput(fResetPin, true) != kIOReturnSuccess) {
+		IOLog("X670 FTS: could not release reset GPIO%u\n", fResetPin);
+		return false;
+	}
+	IOSleep(210); /* Android logs TP Ready about 210 ms after reset release. */
+	IOLog("X670 FTS: VDD GPIO%u on, reset GPIO%u pulsed\n", fVddPin, fResetPin);
+	return true;
 }
 

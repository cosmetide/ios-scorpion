diff --git a/iokit/Kernel/arm/VivaPwrap.cpp b/iokit/Kernel/arm/VivaPwrap.cpp
--- a/iokit/Kernel/arm/VivaPwrap.cpp
+++ b/iokit/Kernel/arm/VivaPwrap.cpp
@@ -189,0 +190,6 @@
+	/* X670 MSDC1 microSD rails: fixed 3.0 V and enable only. */
+	{ 0x1e4c, 0x0fff, 0x0b00 },     /* LDO_VMC: 3.0 V selector */
+	{ 0x1cc4, 0x0001, 0x0001 },     /* LDO_VMC: enable */
